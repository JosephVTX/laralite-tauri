{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laralite",
  "version": "0.1.0",
  "identifier": "dev.laralite.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Laralite", "width": 1100, "height": 720, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
